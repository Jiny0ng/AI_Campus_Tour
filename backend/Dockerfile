# -------------------------------------------------
# Python 3.12 슬림 이미지를 베이스로 사용
# (슬림: 불필요한 파일을 제거한 가벼운 버전)
# -------------------------------------------------
FROM python:3.12-slim

# 컨테이너 안에서 작업할 기본 폴더 지정
WORKDIR /app

# 패키지 목록을 먼저 복사하고 설치 (레이어 캐싱 최적화)
# - requirements.txt만 바뀌지 않으면 이 단계는 캐시를 그대로 써서 빌드가 빨라짐
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 나머지 소스코드를 복사
COPY . .

# 컨테이너가 시작될 때 실행할 명령어
# --reload: 코드가 바뀌면 서버가 자동으로 재시작 (개발 모드)
# --host 0.0.0.0: 컨테이너 외부에서도 접근 가능하게 설정
CMD ["uvicorn", "main:app", "--reload", "--host", "0.0.0.0", "--port", "8000"]
