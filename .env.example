NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
GOOGLE_API_KEY=your_google_ai_key

# 프론트엔드가 백엔드 서버와 통신할 때 사용하는 주소입니다.
# Nginx와 Docker Compose를 사용하여 백엔드가 외부로 직접 노출되지 않으므로
# 도커 내부 네트워크 호스트명인 http://backend:8000 을 사용합니다.
API_BASE_URL=http://backend:8000

# Browser-exposed NAVER Maps key.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your_naver_map_ncp_key_id
# Server-only credential for NAVER Maps Directions 5. Never prefix this with NEXT_PUBLIC_.
NAVER_MAP_CLIENT_SECRET=your_naver_map_client_secret

# Caddy 접속 주소. 로컬 기본값은 http://localhost이며, GCP 배포 시 워크플로가
# VM 주소를 기반으로 공개 HTTPS 도메인을 자동 주입합니다.
CAMPUS_SITE_ADDRESS=http://localhost

# Google Cloud 공용 음성 안내 (Compute Engine에서는 ADC 서비스 계정 사용)
GCP_PROJECT_ID=your_gcp_project_id
GOOGLE_CLOUD_REGION=global
TTS_BUCKET_NAME=your_private_audio_bucket
TTS_MODEL=gemini-2.5-flash-tts
TTS_VOICE_NAME=Kore
TTS_PROMPT_VERSION=v1
DOCENT_SCRIPT_MODEL=gemini-2.5-flash
DOCENT_SCRIPT_PROMPT_VERSION=v1
TTS_REALTIME_ENABLED=true
# 쉼표로 구분한 직접 브라우저 요청 허용 origin. 비어 있으면 Origin이 있는 요청은 차단하고 내부 서버 간 요청만 허용합니다.
TTS_ALLOWED_ORIGINS=
