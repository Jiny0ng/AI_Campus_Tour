NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
GOOGLE_API_KEY=your_google_ai_key

# Server-side FastAPI base URL.
# Use http://campus-ai-backend:8000 when the Next.js server runs inside Docker Compose.
API_BASE_URL=http://localhost:8001

# Browser-exposed NAVER Maps key.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your_naver_map_ncp_key_id
