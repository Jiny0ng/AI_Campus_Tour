NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me
GOOGLE_API_KEY=your_google_ai_key

# 프론트엔드가 백엔드 서버와 통신할 때 사용하는 주소입니다.
# Nginx와 Docker Compose를 사용하여 백엔드가 외부로 직접 노출되지 않으므로
# 도커 내부 네트워크 호스트명인 http://backend:8000 을 사용합니다.
API_BASE_URL=http://backend:8000

# Browser-exposed NAVER Maps key.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=your_naver_map_ncp_key_id
# Server-only credential for NAVER Maps Directions 5. Never prefix this with NEXT_PUBLIC_.
NAVER_MAP_CLIENT_SECRET=your_naver_map_client_secret
